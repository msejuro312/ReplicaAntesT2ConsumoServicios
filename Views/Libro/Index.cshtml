@model IEnumerable<WebApplication1.Models.Libro>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<p>
    @TempData["message"]
</p>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LibroId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AutorId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
